# ideas/input — verbatim checkpoints (optional gitignore per project)
# ideas/input/

# Baserow env — contains secrets, never commit
.env

# Wrangler local secrets (Google OAuth, GitHub App) — never commit
.dev.vars

# Project MCP config — contains Baserow MCP endpoint token
.trae/mcp.json

# Decap CMS local proxy credentials (dev-only)
.htpasswd

# Laika CMS local build output + AI session store (dev-only)
.local/
data/ai-sessions.json

# Baserow data volumes
pgdata/
media/

# Astro build output
dist/

# Astro + Wrangler local state
.astro/
.wrangler/

# Dependencies
node_modules/
