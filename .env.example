# Laika CMS local dev server (server/index.mjs). Copy to .env and fill in.
# .env is gitignored; this file is the committed template.

# Required for the AI chat assistant (any OpenRouter model).
OPENROUTER_API_KEY=

# Any OpenRouter model slug; openrouter/auto routes automatically.
OPENROUTER_MODEL=openrouter/auto

# Port for the local server (static site + admin + proxy + AI).
PORT=8788

# ── Site admin login — DecapCMS via Google OAuth (Worker /auth + /callback)
# Google OAuth app → https://console.cloud.google.com/apis/credentials
# callback: https://ongmataviva.pages.dev/callback  (+ http://localhost:8786/callback p/ dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist of editor emails allowed into /admin. Fail-closed.
ADMIN_EMAILS=

# GitHub App (https://github.com/settings/apps) installed on ongmataviva/website
# with Contents: read & write. Used by the site admin login (DecapCMS).
# PRIVATE_KEY = the app PEM key, base64-encoded:
#   base64 -i /path/to/app.pem  (or: cat app.pem | base64)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# R2 bucket binding DOC_BUCKET = mataviva-documents (add in the Pages project
# dashboard under Settings → Functions → R2 bucket bindings).
# DOC_BUCKET=
